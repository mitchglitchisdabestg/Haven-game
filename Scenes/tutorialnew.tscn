[node name="RichTextLabel9" type="RichTextLabel" parent="." unique_id=1528847921]
offset_left = 9359.0
offset_top = -1560.0
offset_right = 10059.0
offset_bottom = -1451.0
theme_override_fonts/normal_font = ExtResource("3_itw2k")
theme_override_font_sizes/normal_font_size = 30
theme_override_font_sizes/bold_font_size = 35
bbcode_enabled = true
text = "You can press [b]ctrl[/b] to crouch.
You can also jump while crouching to do a charged jump.
Try to get across this big gap with a charged jump."
fit_content = true
autowrap_mode = 0

[node name="RichTextLabel11" type="RichTextLabel" parent="." unique_id=1327533657]
offset_left = 9423.0
offset_top = -1803.0
offset_right = 10123.0
offset_bottom = -1694.0
theme_override_fonts/normal_font = ExtResource("3_itw2k")
theme_override_font_sizes/normal_font_size = 30
theme_override_font_sizes/bold_font_size = 35
bbcode_enabled = true
text = "You can do wall jumps.
try to use the wall on the right and the wall on top
and jump between them to get on the top."
fit_content = true
autowrap_mode = 0

[node name="RichTextLabel21" type="RichTextLabel" parent="." unique_id=1949078721]
offset_left = 4825.0
offset_top = -2047.0
offset_right = 5525.0
offset_bottom = -1938.0
theme_override_fonts/normal_font = ExtResource("3_itw2k")
theme_override_font_sizes/normal_font_size = 30
theme_override_font_sizes/bold_font_size = 35
bbcode_enabled = true
text = "You can also wall jump
on the same wall repeatedly.
after wall jumping
move away and back from the wall
to regain a wall jump."
fit_content = true
autowrap_mode = 0

[node name="RichTextLabel32" type="RichTextLabel" parent="." unique_id=497244696]
